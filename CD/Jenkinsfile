pipeline {
    agent any

    environment {
        DOCKERHUB_CREDS = credentials('DevOps_lw1')
    }

    options {
        timestamps()
        skipDefaultCheckout(true)
    }

    stages {
        stage('Login to DockerHub') {
            steps {
                script {
                    bat 'docker login -u %DOCKERHUB_CREDS_USR% -p %DOCKERHUB_CREDS_PSW%'
                }
            }
        }

        stage('Pull Docker Image') {
            steps {
                script {
                    bat 'docker pull demonstage0/devops_lw1:latest'
                }
            }
        }

        stage('Stop and Remove Old Container') {
            steps {
                script {
                    bat 'docker stop glass-api 2>nul'
                    bat 'docker rm glass-api 2>nul'
                    echo "Old container cleaned up"
                }
            }
        }

        stage('Run Container') {
            steps {
                script {
                    bat 'docker run --name glass-api -p 8000:8000 -d demonstage0/devops_lw1:latest'
                }
            }
        }

        stage('Wait for Service Ready') {
            steps {
                script {
                    bat 'timeout /t 10 /nobreak'
                    bat 'curl -f http://localhost:8000/ || (echo "Waiting..." && timeout /t 5 && curl http://localhost:8000/)'
                }
            }
        }

        stage('Functional Test - Health Check') {
            steps {
                script {
                    bat 'curl -f http://localhost:8000/ || exit 1'
                }
            }
        }

        stage('Functional Test - Train Model') {
            steps {
                script {
                    bat 'docker exec glass-api python -c "import requests; r = requests.get(\'http://localhost:8000/train\'); print(r.json()); assert r.status_code == 200"'
                }
            }
        }

        stage('Functional Test - Predict') {
            steps {
                script {
                    bat 'docker exec glass-api python -c "import requests; r = requests.get(\'http://localhost:8000/predict?RI=1.52101&Na=13.64&Mg=4.49&Al=1.1&Si=71.78&K=0.06&Ca=8.75&Ba=0.0&Fe=0.0\'); print(r.json()); assert r.status_code == 200"'
                }
            }
        }

        stage('Show Container Logs') {
            steps {
                script {
                    bat 'docker logs --tail 30 glass-api'
                }
            }
        }
    }

    post {
        always {
            script {
                bat 'docker logout 2>nul || echo "Logged out"'
                echo 'CD Pipeline finished'
            }
        }
        success {
            echo 'CD Pipeline completed! All functional tests passed!'
        }
        failure {
            echo 'CD Pipeline failed! Check logs above.'
        }
    }
}